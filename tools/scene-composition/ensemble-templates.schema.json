            },
            "height": {
              "type": "number"
            },
            "yaw": {
              "type": "number"
            },
            "required": {
              "type": "boolean"
            },
            "entrance": {
              "type": "boolean"
            },
            "growsThrough": {
              "type": [
                "string",
                "null"
              ]
            }
          }
