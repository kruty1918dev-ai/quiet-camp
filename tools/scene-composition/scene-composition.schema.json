{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "season": {
      "enum": [
        "spring",
        "summer",
        "autumn",
        "winter"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "radius": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "x",
          "z"
        ]
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "forest",
              "meadow",
              "field",
              "parcel",
              "water",
              "ruin"
            ]
          },
          "species": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "depth": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "density": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "kind",
          "x",
          "z",
          "width",
          "depth"
        ]
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "road",
              "path",
              "power",
              "distribution"
            ]
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "z"
              ]
            }
          },
          "supportAsset": {
            "type": "string"
          },
          "serviceTargets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minSpan": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxSpan": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "supportHeight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "interpolation": {
            "enum": [
              "linear",
              "smooth-x"
            ]
          },
          "nextRoute": {
            "type": [
              "string",
              "null"
            ]
          },
          "damage": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "span": {
                  "type": "integer",
                  "minimum": 0
                },
                "state": {
                  "enum": [
                    "severed",
                    "hanging-from",
                    "hanging-to",
                    "removed"
                  ]
                },
                "dropLength": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "span",
                "state"
              ]
            }
          },
          "fallenSupports": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "fallenAsset": {
            "type": "string"
          },
          "supportVariants": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "required": [
                "index",
                "asset",
                "height"
              ],
              "additionalProperties": false,
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "asset": {
                  "type": "string",
                  "minLength": 1
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 50
                }
              }
            }
          }
        },
        "required": [
          "id",
          "kind",
          "points"
        ]
      }
    },
    "ensembles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "placement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "zone": {
                "type": "string"
              },
              "nearNode": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "yaw": {
                "type": "number"
              },
              "fixedPosition": {
                "type": "boolean"
              },
              "faceRoute": {
                "type": "boolean"
              }
            },
            "required": [
              "zone"
            ]
          },
          "entranceConnectsTo": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "fenceVariant": {
            "enum": [
              "wattle",
              "picket",
              "concrete"
            ]
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "template",
          "placement"
        ]
      }
    },
    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "revealOwner": {
            "type": "string"
          },
          "interpretation": {
            "const": "fictional"
          },
          "x": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "yaw": {
            "type": "number"
          },
          "compoundOwner": {
            "type": "string"
          },
          "supportMode": {
            "enum": [
              "ground",
              "banks"
            ]
          }
        },
        "required": [
          "id",
          "asset",
          "revealOwner"
        ]
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instances": {
          "type": "integer",
          "minimum": 1
        },
        "materials": {
          "type": "integer",
          "minimum": 1
        },
        "renderers": {
          "type": "integer",
          "minimum": 1
        },
        "cacheBytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": []
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "gravel",
              "bus-bay",
              "pothole",
              "garden",
              "reservoir-bed",
              "channel",
              "erosion",
              "service-yard"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "heightOffset": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "feather": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "points": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "z"
              ]
            }
          },
          "relativeToOwner": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "points"
        ]
      }
    },
    "landscape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "channel",
        "hills",
        "basin",
        "pools"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "waterHeight": {
          "type": "number"
        },
        "damZ": {
          "type": "number"
        },
        "damHeight": {
          "type": "number"
        },
        "channel": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "z",
              "halfWidth"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "halfWidth": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "hills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "z",
              "radiusX",
              "radiusZ",
              "height"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "radiusX": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "radiusZ": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number"
              }
            }
          }
        },
        "basin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "z",
            "radiusX",
            "radiusZ",
            "oldWaterHeight",
            "bedHeight"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "radiusX": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "radiusZ": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "oldWaterHeight": {
              "type": "number"
            },
            "bedHeight": {
              "type": "number"
            },
            "shoreRoughness": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.2
            },
            "bedRoughness": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.4
            }
          }
        },
        "pools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "z",
              "radiusX",
              "radiusZ"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "radiusX": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "radiusZ": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "nodes",
    "zones",
    "routes",
    "ensembles"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quiet-camp/scene-composition/v1",
  "title": "Portable semantic scene composition"
}
