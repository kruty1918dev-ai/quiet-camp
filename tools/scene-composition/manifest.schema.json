{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "regions",
    "assets",
    "templates",
    "coordinateSpace",
    "compilerRevision"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+\\.json$"
      }
    },
    "assets": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.json$"
    },
    "templates": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.json$"
    },
    "coordinateSpace": {
      "const": "metres-y-up"
    },
    "compilerRevision": {
      "type": "string",
      "minLength": 1
    }
  }
}
