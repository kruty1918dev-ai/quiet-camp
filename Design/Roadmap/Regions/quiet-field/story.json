      "claims": [
        {
          "id": "quiet-field:engine-type",
          "statement": "The JIT associates engine type 9д 131 with 9M38/9M38M1. Only its photographed type prefix may inform a fictional casing; no unique serial or operator attribution. The 2018 update expressly leaves the shown parts’ connection to the launched missile uncertain.",
          "sourceIds": [
            "quiet-field:jit-source",
            "quiet-field:casing-photo"
          ]
        },
        {
          "id": "quiet-field:stabilizer-form",
          "statement": "DSB Figure 36 shows an engine nozzle, partial stabilizer fin and data cable consistent with a 9M38-series surface-to-air missile. A fictional partial fin may use that geometry reference; silhouette alone is not forensic proof.",
          "sourceIds": [
            "quiet-field:parts-source"
          ]
        },
        {
          "id": "quiet-field:buk-court",
          "statement": "The Court’s 2022 summary states MH17 was hit by a Buk missile launched from a farm field near Pervomaiskyi. This documented conclusion does not authenticate invented game fragments.",
          "sourceIds": [
            "quiet-field:court-source"
          ]
        }
      ]
    }
  ],
