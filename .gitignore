# Unity gitignore — repo root contains the QuietCamp/ project directory
# Reference: https://github.com/github/gitignore/blob/main/Unity.gitignore

# Unity generated folders (matched at any depth since project is in QuietCamp/)
**/[Ll]ibrary/
# A regenerable cache can be relocated to the data disk using a symlink.
**/[Ll]ibrary
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/
# Reproducible marketing takes, decoded frames and delivery movies stay local.
QuietCamp/Marketing/Exports/
.utmp/

# Never commit secrets — Android signing stays outside the repo
*.keystore
*.keystore.meta
keypass.txt

# Blender backups
*.blend1
*.blend1.meta

# Autogenerated IDE / build files
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
!tools/optional-google-probe/Probe.csproj
!tools/privacy-probe/Probe.csproj
!tools/MonetizationProbe.csproj
!tools/EnvironmentIntegrationProbe.csproj
!QuietCamp/Packages/com.kruty1918.*/Tests~/Contracts.csproj
!tools/roadmap-pipeline/RoadmapPipeline.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user
*.pidb.meta
sysinfo.txt
**/mono_crash.*
*.apk
*.aab
*.unitypackage
*.app/
crashlytics-build.properties

# OS clutter
.DS_Store
Thumbs.db

# Local QA logs / test artifacts
qc_*.log
qc_*.xml
TestResults*.xml

# Test runner output + device captures
TestResults/
DeviceScreenshots/
*.zip

# Unity performance-test artifacts
QuietCamp/Assets/Resources/PerformanceTestRun*.json*

# AgentVerify staging files (agent run artifacts)
agentverify.commands.json
agentverify.results.json
BuildLogs/
.vscode/
**/__pycache__/
*.py[cod]
tools/**/bin/
/osint_plan.md
/privacy_plan.md

# Locally restored commercial donor packages; retained in the supplied private ZIP.
# Preserve original vendor paths and GUIDs without publishing their source files.
/QuietCamp/Assets/PolygonCity/
/QuietCamp/Assets/PolygonCity.meta
/QuietCamp/Assets/PolygonBattleRoyale/
/QuietCamp/Assets/PolygonBattleRoyale.meta
/QuietCamp/Assets/PolygonNatureBiomes/
/QuietCamp/Assets/PolygonNatureBiomes.meta
/QuietCamp/Assets/PolygonParticles/
/QuietCamp/Assets/PolygonParticles.meta
/QuietCamp/OptionalAssets~/
/QuietCamp/mono_crash.*

# Private donor-model photographs and local review gallery
Design/Roadmap/ModelCatalogue/LocalPreviews~/
Design/Roadmap/ConceptRenders/*/Inputs~/

# Local vendor source photography for the complete model catalogue
Design/Campaign100/**/ModelPreviews~/
Design/Campaign100/**/SourcePhotos~/

# Temporary native photographs of already installed Unity package sources
QuietCamp/Assets/QuietCamp/Editor/CampaignModelPhotography/
QuietCamp/Assets/QuietCamp/Editor/CampaignModelPhotography.meta
# Licensed tools are installed locally from the owner's package.
QuietCamp/Assets/PluginMaster/
QuietCamp/Assets/PluginMaster.meta
QuietCamp/Assets/QuietCamp/Editor/LevelAuthoring/Palette/
QuietCamp/Assets/QuietCamp/Editor/LevelAuthoring/Palette.meta
QuietCamp/Assets/QuietCamp/Editor/LevelAuthoring/Workspaces/
QuietCamp/Assets/QuietCamp/Editor/LevelAuthoring/Workspaces.meta
QuietCamp/Assets/WaterGeometryTools/
QuietCamp/Assets/WaterGeometryTools.meta
QuietCamp/Assets/Plugins/Sirenix/
QuietCamp/Assets/Plugins/Sirenix.meta
QuietCamp/Assets/QuietCamp/Editor/LevelAuthoring/SceneBackups/
QuietCamp/Assets/QuietCamp/Editor/LevelAuthoring/SceneBackups.meta
QuietCamp/Packages/com.jbooth.microverse*/

# Regenerated promo payload; capture/validation receipts are kept under Design.
/Deliverables/QuietCamp-100-Levels/

# Owner-only input and generated native client configuration
/Config/owner.local.json
/QuietCamp/Assets/google-services.json
/QuietCamp/Assets/google-services.json.meta
/QuietCamp/Assets/QuietCamp/Resources/QuietCamp/owner_client.json
/QuietCamp/Assets/QuietCamp/Resources/QuietCamp/owner_client.json.meta
/Temp/
